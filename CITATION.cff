  - given-names: Shihefeng
    family-names: Wang
  - given-names: Kangchen
    family-names: Lv
  # Mingrui Yu and Xiang Li are co-corresponding authors.
  - given-names: Mingrui
    family-names: Yu
  - given-names: Xiang
    family-names: Li
contact:
  # CFF has no dedicated "corresponding author" role; contact records the two
  # co-corresponding authors without inventing email addresses.
  - given-names: Mingrui
    family-names: Yu
  - given-names: Xiang
    family-names: Li
keywords:
  - cross-embodiment deployment
  - visuomotor policy
  - whole-body collision avoidance
  - joint-space guidance
  - diffusion policy
